                        "start" : 530587680000, 
                        "duration" : 48168960000, 
                        "mediaStart" : 0, 
                        "mediaDuration" : 48168960000, 
                        "scalar" : 1, 
                        "animationTracks" : {
                        }
                      }, 
                    "audio" : 
                      {
                        "id" : 32, 
                        "_type" : "AMFile", 
                        "src" : 5, 
                        "trackNumber" : 3, 
                        "attributes" : {
                          "ident" : "", 
                          "gain" : 1.0, 
                          "mixToMono" : false, 
                          "loudnessNormalization" : true, 
                          "sourceFileOffset" : 0
                        }, 
                        "channelNumber" : "0", 
                        "parameters" : {
                          "captions" : {
                            "type" : "caption", 
                            "keyframes" : [
                              {
                                "endTime" : 0, 
                                "time" : 0, 
                                "value" : { "text" : "I'll close with a few of the thoughts on the two takeaways that I framed initially.", "textAttributes" : null }, 
                                "duration" : 0
                              }, 
                              {
                                "endTime" : 4339351800, 
                                "time" : 4339351800, 
                                "value" : { "text" : "First of all, as I said, no single unit at your institution probably owns everything associated with exam", "textAttributes" : null }, 
                                "duration" : 0
                              }, 
                              {
                                "endTime" : 8589886200, 
                                "time" : 8589886200, 
                                "value" : { "text" : "{\\rtf1\\ansi\\ansicpg1252\\cocoartf2870\n\\cocoatextscaling0\\cocoaplatform0{\\fonttbl\\f0\\fswiss\\fcharset0 ArialMT;}\n{\\colortbl;\\red255\\green255\\blue255;\\red54\\green66\\blue74;}\n{\\*\\expandedcolortbl;;\\cssrgb\\c27451\\c32941\\c36078;}\n\\pard\\tx560\\tx1120\\tx1680\\tx2240\\tx2800\\tx3360\\tx3920\\tx4480\\tx5040\\tx5600\\tx6160\\tx6720\\pardirnatural\\partightenfactor0\n\n\\f0\\fs36 \\cf2 administration. You will be herding cats across boundaries, but the results are well worth it.}", "textAttributes" : null }, 
                                "duration" : 0
                              }, 
                              {
                                "endTime" : 13304440800, 
                                "time" : 13304440800, 
                                "value" : { "text" : "Second, it's not all or nothing, it's all or something. You can do a smaller part-time CBTF,", "textAttributes" : null }, 
                                "duration" : 0
                              }, 
                              {
                                "endTime" : 17826807600, 
                                "time" : 17826807600, 
                                "value" : { "text" : "you don't have to do it at scale, and you will still realize most of the benefits. Just make sure that when you are planning your", "textAttributes" : null }, 
                                "duration" : 0
                              }, 
                              {
                                "endTime" : 22115885400, 
                                "time" : 22115885400, 
                                "value" : { "text" : "policies and procedures, you plan them to scale up. And as you're scaling up, message every victory in", "textAttributes" : null }, 
                                "duration" : 0
                              }, 
                              {
                                "endTime" : 26454267000, 
                                "time" : 26454267000, 
                                "value" : { "text" : "{\\rtf1\\ansi\\ansicpg1252\\cocoartf2870\n\\cocoatextscaling0\\cocoaplatform0{\\fonttbl\\f0\\fswiss\\fcharset0 ArialMT;}\n{\\colortbl;\\red255\\green255\\blue255;\\red54\\green66\\blue74;}\n{\\*\\expandedcolortbl;;\\cssrgb\\c27451\\c32941\\c36078;}\n\\pard\\tx560\\tx1120\\tx1680\\tx2240\\tx2800\\tx3360\\tx3920\\tx4480\\tx5040\\tx5600\\tx6160\\tx6720\\pardirnatural\\partightenfactor0\n\n\\f0\\fs36 \\cf2 terms that each of your stakeholders can understand. They will see that there are some benefits to be had at small scale}", "textAttributes" : null }, 
                                "duration" : 0
                              }, 
                              {
                                "endTime" : 30961287000, 
                                "time" : 30961287000, 
                                "value" : { "text" : "and they can be transformative at large scale. If we did it at my bureaucratic institution, we're confident that", "textAttributes" : null }, 
                                "duration" : 0
                              }, 
                              {
                                "endTime" : 35269151400, 
                                "time" : 35269151400, 
                                "value" : { "text" : "{\\rtf1\\ansi\\ansicpg1252\\cocoartf2870\n\\cocoatextscaling0\\cocoaplatform0{\\fonttbl\\f0\\fswiss\\fcharset0 ArialMT;}\n{\\colortbl;\\red255\\green255\\blue255;\\red54\\green66\\blue74;}\n{\\*\\expandedcolortbl;;\\cssrgb\\c27451\\c32941\\c36078;}\n\\pard\\tx560\\tx1120\\tx1680\\tx2240\\tx2800\\tx3360\\tx3920\\tx4480\\tx5040\\tx5600\\tx6160\\tx6720\\pardirnatural\\partightenfactor0\n\n\\f0\\fs36 \\cf2 you can do it as well. I look forward to hearing from you, and if there's any way that I can help or provide additional information}", "textAttributes" : null }, 
                                "duration" : 0
                              }, 
                              {
                                "endTime" : 39704023800, 
                                "time" : 39704023800, 
                                "value" : { "text" : "{\\rtf1\\ansi\\ansicpg1252\\cocoartf2870\n\\cocoatextscaling0\\cocoaplatform0{\\fonttbl\\f0\\fswiss\\fcharset0 ArialMT;}\n{\\colortbl;\\red255\\green255\\blue255;\\red54\\green66\\blue74;}\n{\\*\\expandedcolortbl;;\\cssrgb\\c27451\\c32941\\c36078;}\n\\pard\\tx560\\tx1120\\tx1680\\tx2240\\tx2800\\tx3360\\tx3920\\tx4480\\tx5040\\tx5600\\tx6160\\tx6720\\pardirnatural\\partightenfactor0\n\n\\f0\\fs36 \\cf2 beyond what's in the paper or in this talk that would help you set this up at your own institution, I'll be more than happy to do so.}", "textAttributes" : null }, 
                                "duration" : 0
                              }, 
                              {
                                "endTime" : 44570811600, 
                                "time" : 44570811600, 
                                "value" : { "text" : "{\\rtf1\\ansi\\ansicpg1252\\cocoartf2870\n\\cocoatextscaling0\\cocoaplatform0{\\fonttbl\\f0\\fswiss\\fcharset0 ArialMT;}\n{\\colortbl;\\red255\\green255\\blue255;\\red54\\green66\\blue74;}\n{\\*\\expandedcolortbl;;\\cssrgb\\c27451\\c32941\\c36078;}\n\\pard\\tx560\\tx1120\\tx1680\\tx2240\\tx2800\\tx3360\\tx3920\\tx4480\\tx5040\\tx5600\\tx6160\\tx6720\\pardirnatural\\partightenfactor0\n\n\\f0\\fs36 \\cf2 Thank you very much for your time and attention, and GO BEARS!}", "textAttributes" : null }, 
                                "duration" : 0
                              }
                            ]
                          }
