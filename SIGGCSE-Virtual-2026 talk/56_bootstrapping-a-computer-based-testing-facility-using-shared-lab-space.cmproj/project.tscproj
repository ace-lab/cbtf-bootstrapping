                                "duration" : 0
                              }, 
                              {
                                "endTime" : 87564783600, 
                                "time" : 87564783600, 
                                "value" : { "text" : "A lot of the benefits appear at smaller scale and the devil is in the details, which is why I hope that this talk will encourage", "textAttributes" : null }, 
                                "duration" : 0
                              }, 
